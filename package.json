{
	"name": "@mad-c/router",
	"version": "0.1.0",
	"description": "Simple router for simple web server",
	"keywords": [
		"router",
		"urlpattern",
		"server"
	],
	"author": "madcampos",
	"license": "LGPL-3.0-or-later",
	"type": "module",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.0.7",
			"onFail": "error"
		}
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"type": "./dist/index.d.ts"
		},
		"./node-adapter": {
			"import": "./dist/node-adapter.js",
			"types": "./dist/node-adapter.d.ts"
		}
	},
	"scripts": {
		"prepublishOnly": "pnpm run build",
		"build": "tsc",
		"format": "dprint fmt",
		"typecheck": "tsc --noEmit",
		"lint:js": "oxlint --fix",
		"lint": "pnpm run typecheck && pnpm run lint:js",
		"test": "vitest"
	},
	"devDependencies": {
		"@types/node": "^25.9.3",
		"@vitest/coverage-v8": "^4.1.8",
		"dprint": "^0.54.0",
		"oxlint": "^1.69.0",
		"oxlint-tsgolint": "^0.23.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	}
}
